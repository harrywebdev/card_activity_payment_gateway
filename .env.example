# ─── Database ─────────────────────────────────────────────────────────────────
# Prisma connection string. Locally use file:./data/dev.db; in Disco it lives on
# the mounted /app/data volume.
DATABASE_URL="file:./data/dev.db"

# ─── GoPay ────────────────────────────────────────────────────────────────────
# Credentials from your GoPay merchant dashboard.
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_MERCHANT_ID=
# "true" → hit GoPay sandbox; default "false" (production).
GOPAY_SANDBOX=false

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Comma-separated list of emails allowed to request a magic link.
# Normalised to lowercase + trimmed at boot. Anything else gets silent-success.
ALLOWED_EMAILS=you@example.com,other@example.com
# iron-session encryption key. Must be at least 32 bytes.
# Generate with: openssl rand -base64 48
COOKIE_SECRET=

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Shared bearer token for scripts/cron-*.sh → /api/cron/* authentication.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# ─── Email (Mailgun) ──────────────────────────────────────────────────────────
# Mailgun API key (free tier: 5k emails/mo, plenty for magic links).
# https://app.mailgun.com → API security → "Mailgun API keys"
MAILGUN_API_KEY=
# The sending domain you've verified in Mailgun (e.g. mg.kupsiodstin.cz)
# or, before you verify a domain, the sandbox subdomain Mailgun assigns you
# (sandboxXXXX.mailgun.org — recipients must be verified on the free sandbox).
MAILGUN_DOMAIN=
# The From header to send with. Must be on MAILGUN_DOMAIN.
# Examples:
#   Kup si Odstín <noreply@mg.kupsiodstin.cz>
#   noreply@sandboxXXXX.mailgun.org
MAILGUN_FROM=
# "eu" if the Mailgun account was created in the EU region (default),
# "us" if in the US. Mailgun shows the right one in the dashboard's API URL.
MAILGUN_REGION=eu

# ─── Telegram notifications ───────────────────────────────────────────────────
# Bot token from @BotFather, and the chat ID to send notifications to.
# Also used by disco.json deploy hooks for deploy pings.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Web ──────────────────────────────────────────────────────────────────────
# Public origin — used in magic-link emails and GoPay return URLs.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# "development" enables the Prisma global cache for HMR + dev-only UI affordances.
NEXT_PUBLIC_APP_ENV="development"

# ─── Modes ────────────────────────────────────────────────────────────────────
# "true" → planner + executor run but GoPay/Resend/Telegram sends are skipped.
DRY_RUN=false
